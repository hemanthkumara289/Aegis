# ==============================================================================
# Aegis Platform — Environment Variables Example
# Copy this file to .env before running docker-compose or local services
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration (Used starting Milestone 1.2)
POSTGRES_DB=aegis
POSTGRES_USER=aegis_app
POSTGRES_PASSWORD=aegis_secret_pass
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aegis
SPRING_DATASOURCE_USERNAME=aegis_app
SPRING_DATASOURCE_PASSWORD=aegis_secret_pass

# Security & Cryptography Configuration
# IMPORTANT: Generate secure random keys (e.g. openssl rand -base64 32)
AEGIS_JWT_SECRET=<base64-encoded-32-byte-secret>
AEGIS_JWT_EXPIRATION_SECONDS=900
AEGIS_REFRESH_TOKEN_EXPIRATION_DAYS=7

# OTP Configuration
AEGIS_OTP_HMAC_SECRET=<base64-encoded-32-byte-secret>
AEGIS_OTP_TTL_MINUTES=10
AEGIS_OTP_MAX_ATTEMPTS=5

# Audit Trail HMAC Chain Configuration
AEGIS_AUDIT_HMAC_SECRET=<base64-encoded-32-byte-secret>

# MailHog SMTP Configuration (Used starting Milestone 1.4)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
